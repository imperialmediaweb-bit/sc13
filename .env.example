# === Notificări push (Web Push / VAPID) ===
# Generează o pereche nouă cu:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adresa de contact (obligatoriu de forma mailto:...)
VAPID_SUBJECT=mailto:contact@exemplu.ro
# Secret cu care trimiți notificări și citești rapoartele (alege ceva greu de ghicit)
NOTIFY_SECRET=schimba-ma

# === Cloudinary (pentru încărcarea pozelor/video din formularul de raportare) ===
# Din contul Cloudinary: numele cloud-ului și un "unsigned upload preset".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# === Persistență (opțional, recomandat pe Railway cu un volum) ===
# Căile fișierelor unde se salvează abonamentele și rapoartele.
# SUBS_FILE=/data/subs.json
# REPORTS_FILE=/data/reports.json
